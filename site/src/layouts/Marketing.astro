---
import Base from './Base.astro';
import Footer from '../components/Footer.astro';
import { base } from '../lib/courses';
const { title, description } = Astro.props;
---
<Base title={title} description={description}>
  <header class="mnav">
    <div class="inner">
      <a class="brand" href={base}><span class="mark">CS</span><span class="name">UT CS Course Explorer</span></a>
      <nav class="links" aria-label="Primary">
        <a href={`${base}#courses`}>Courses</a>
        <a href={`${base}topics/`}>Search by topic</a>
        <a href={`${base}about/`}>About &amp; sources</a>
      </nav>
      <span class="spacer"></span>
      <a class="btn primary" href={`${base}topics/`}>Search by topic <span class="arr">→</span></a>
    </div>
  </header>
  <slot />
  <Footer />
</Base>
